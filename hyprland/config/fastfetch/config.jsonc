// fastfetch layout from the KDE screenshots. install.sh fills in the logo:
// your own image if you picked one, the Arch logo otherwise.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": @LOGO@,
    "display": {
        "separator": ": ",
        "color": {
            "keys": "cyan",
            "title": "cyan"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "shell",
        "display",
        { "type": "de", "key": "Desktop Environment" },
        { "type": "wm", "key": "Window Manager" },
        "theme",
        "icons",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "localip",
        "break",
        "colors"
    ]
}
