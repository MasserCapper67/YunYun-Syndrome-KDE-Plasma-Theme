#!/usr/bin/env bash
# Screenshot to ~/Pictures/Screenshots and the clipboard.
# Usage: yunyun-screenshot region|screen

set -euo pipefail

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +'%Y-%m-%d_%H-%M-%S').png"

case "${1:-region}" in
    region)
        geometry="$(slurp)" || exit 0
        grim -g "$geometry" "$file"
        ;;
    screen)
        grim "$file"
        ;;
    *)
        echo "usage: $0 region|screen" >&2
        exit 1
        ;;
esac

wl-copy < "$file"
notify-send -a "Screenshot" -i "$file" "Screenshot saved" "$file"
